<script>
/* ---------- section + item reveal transitions ---------- */
(function(){
  var root = document.documentElement;
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduce || !('IntersectionObserver' in window)) return;

  var secs = document.querySelectorAll('.page > section');

  /* One signature motion per section. `scope` is null for the hero,
     otherwise the index of the section the selector belongs to. */
  var plan = [
    /* HERO: light coming into focus */
    {scope:null, sel:'.hero .badge',   cls:'rv-badge'},
    {scope:null, sel:'.hero h1',       cls:'rv-focusin', delay:140},
    {scope:null, sel:'.hero .sub',     cls:'rv-focusin', delay:360},
    {scope:null, sel:'.hero .idcard',  cls:'rv-card',    delay:560},

    /* 0 MISSION: swings open on a hinge */
    {scope:0, sel:'.sec-head', cls:'rv-door'},
    {scope:0, sel:'.prose',    cls:'rv-door', delay:340},

    /* 1 PIVOT: settles straight, then the strike is drawn */
    {scope:1, sel:'.pivot', cls:'rv-settle'},

    /* 2 BASELINE: figures resolve out of blur, in reading order */
    {scope:2, sel:'.sec-head',   cls:'rv-drop'},
    {scope:2, sel:'.bento .cell',cls:'rv-resolve', delay:260, step:165},

    /* 3 THE SHIFT: the two models close in from opposite sides */
    {scope:3, sel:'.sec-head',  cls:'rv-drop'},
    {scope:3, sel:'.model.old', cls:'rv-left',  delay:200},
    {scope:3, sel:'.model.new', cls:'rv-right', delay:200},
    {scope:3, sel:'.arrowbox',  cls:'rv-pop',   delay:1150},

    /* 4 HABITS: cards dealt face up */
    {scope:4, sel:'.sec-head', cls:'rv-slidein'},
    {scope:4, sel:'.feature',  cls:'rv-deal', delay:300, step:230},

    /* 5 HANDOVER: rows slide across, checks stamp on, board wipes open */
    {scope:5, sel:'.sec-head', cls:'rv-slidein'},
    {scope:5, sel:'.checks li',cls:'rv-row',  delay:230, step:155},
    {scope:5, sel:'.board',    cls:'rv-quiet'},
    {scope:5, sel:'.board p',  cls:'rv-quiet', delay:220},
    {scope:5, sel:'.brow',     cls:'rv-wipe',  delay:400, step:170},

    /* 6 LESSONS: realisations coming clear */
    {scope:6, sel:'.sec-head', cls:'rv-clear'},
    {scope:6, sel:'.feature',  cls:'rv-clear', delay:330, step:265},

    /* 7 CLOSE: the slowest, a breath out */
    {scope:7, sel:'.close', cls:'rv-breathe'}
  ];

  var items = [];

  plan.forEach(function(p){
    var host = (p.scope === null) ? document : secs[p.scope];
    if(!host) return;
    var nodes = host.querySelectorAll(p.sel);
    Array.prototype.forEach.call(nodes, function(el, i){
      if(el.classList.contains('rv')) return;
      el.classList.add('rv', p.cls);
      var d = p.delay || 0;
      if(p.step) d += i * p.step;
      if(d) el.style.setProperty('--d', d + 'ms');
      items.push(el);
    });
  });

  if(!items.length) return;
  root.setAttribute('data-rv','on');

  var pending = [];
  var io = null;

  /* Plays a part's transition exactly once, then locks the finished
     state so it stays put for the rest of the visit. */
  function show(el){
    if(el.classList.contains('in')) return;
    el.classList.add('in');

    var k = pending.indexOf(el);
    if(k > -1) pending.splice(k, 1);
    if(io) io.unobserve(el);

    var hold = (parseFloat(el.style.getPropertyValue('--d')) || 0) + 3200;
    var lock = function(){
      el.classList.add('done');
      el.removeEventListener('transitionend', onEnd);
    };
    var onEnd = function(e){
      if(e.target !== el) return;
      clearTimeout(el._lockT);
      el._lockT = setTimeout(lock, 900); /* let child delays finish too */
    };
    el.addEventListener('transitionend', onEnd);
    el._lockT = setTimeout(lock, hold);
  }

  /* Only the opening screen appears without scrolling, so the first
     frame is complete. Everything lower waits for the viewer to
     reach it, and plays the first time they do. */
  var vh = window.innerHeight || 800;
  var ready = [];
  items.forEach(function(el){
    if(el.getBoundingClientRect().top < vh * 0.72){ ready.push(el); }
    else { pending.push(el); }
  });

  io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      /* Fires on arrival, and also catches anything already scrolled
         past, so a fast scroll can never skip a part. */
      if(e.isIntersecting || e.boundingClientRect.top < 0) show(e.target);
    });
  }, {rootMargin:'0px 0px -24% 0px', threshold:0.3});

  pending.slice().forEach(function(el){ io.observe(el); });
  ready.forEach(show);

  /* Safety net: sweep on scroll for anything the observer misses. */
  var ticking = false;
  function sweep(){
    ticking = false;
    var h = window.innerHeight || 800;
    pending.slice().forEach(function(el){
      if(el.getBoundingClientRect().top < h * 0.76) show(el);
    });
    if(!pending.length){
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
    }
  }
  function onScroll(){
    if(!ticking){ ticking = true; requestAnimationFrame(sweep); }
  }
  window.addEventListener('scroll', onScroll, {passive:true});
  window.addEventListener('resize', onScroll, {passive:true});

  /* Failsafe: never leave anything hidden. */
  setTimeout(function(){ items.forEach(show); }, 14000);
  window.addEventListener('pagehide', function(){ items.forEach(show); });
})();

