<title>Holding the Door Open</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300..700&display=swap">

<style>
  :root{
    --ground:#FAF5F2;
    --ground-2:#F3EBE6;
    --ink:#3A2634;
    --ink-soft:#5A4256;
    --muted:#7C6577;
    --faint:#A08EA0;

    --plum:#7A4A82;
    --plum-deep:#5C3364;
    --rose:#B4666E;
    --apricot:#CE8F55;
    --sage:#6E8F7D;
    --lavender:#C7B0D2;

    --g-dawn:linear-gradient(135deg,#7A4A82 0%,#B4666E 55%,#CE8F55 100%);
    --g-dusk:linear-gradient(135deg,#5C3364 0%,#8A5A80 100%);
    --g-warm:linear-gradient(135deg,#B4666E 0%,#D9A765 100%);
    --g-calm:linear-gradient(135deg,#6E8F7D 0%,#8FA98C 100%);

    --glass:rgba(255,255,255,.58);
    --glass-strong:rgba(255,255,255,.76);
    --glass-edge:rgba(255,255,255,.82);
    --glass-line:rgba(122,74,130,.16);

    --shadow-data:0 1px 3px rgba(58,38,52,.07), 0 12px 28px -12px rgba(122,74,130,.30), 0 28px 54px -30px rgba(180,102,110,.28);
    --shadow-card:0 1px 2px rgba(58,38,52,.05), 0 14px 34px -20px rgba(92,51,100,.30);

    --font:"Inter", "Helvetica Neue", Arial, sans-serif;

    --mote-a:rgba(214,158,96,.46);
    --mote-b:rgba(180,102,110,.36);
    --mote-c:rgba(140,96,160,.34);
  }

  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --ground:#1B1219;
      --ground-2:#241823;
      --ink:#F6EEF2;
      --ink-soft:#E0CFDA;
      --muted:#B49FAF;
      --faint:#8A7484;

      --plum:#C9A4D2;
      --plum-deep:#B089BC;
      --rose:#E0969E;
      --apricot:#E5B078;
      --sage:#9CBCA8;
      --lavender:#8E6C9C;

      --g-dawn:linear-gradient(135deg,#B089BC 0%,#DA8F98 55%,#E5B078 100%);
      --g-dusk:linear-gradient(135deg,#8E6C9C 0%,#C48CAE 100%);
      --g-warm:linear-gradient(135deg,#DA8F98 0%,#E8BC84 100%);
      --g-calm:linear-gradient(135deg,#7FA890 0%,#9CBCA8 100%);

      --glass:rgba(255,255,255,.065);
      --glass-strong:rgba(255,255,255,.11);
      --glass-edge:rgba(255,255,255,.15);
      --glass-line:rgba(201,164,210,.22);

      --shadow-data:0 1px 3px rgba(0,0,0,.38), 0 12px 28px -12px rgba(0,0,0,.52), 0 28px 54px -30px rgba(0,0,0,.60);
      --shadow-card:0 1px 2px rgba(0,0,0,.34), 0 14px 34px -20px rgba(0,0,0,.50);

      --mote-a:rgba(229,176,120,.40);
      --mote-b:rgba(218,143,152,.34);
      --mote-c:rgba(176,137,188,.36);
    }
  }
  :root[data-theme="dark"]{
    --ground:#1B1219;
    --ground-2:#241823;
    --ink:#F6EEF2;
    --ink-soft:#E0CFDA;
    --muted:#B49FAF;
    --faint:#8A7484;
    --plum:#C9A4D2;
    --plum-deep:#B089BC;
    --rose:#E0969E;
    --apricot:#E5B078;
    --sage:#9CBCA8;
    --lavender:#8E6C9C;
    --g-dawn:linear-gradient(135deg,#B089BC 0%,#DA8F98 55%,#E5B078 100%);
    --g-dusk:linear-gradient(135deg,#8E6C9C 0%,#C48CAE 100%);
    --g-warm:linear-gradient(135deg,#DA8F98 0%,#E8BC84 100%);
    --g-calm:linear-gradient(135deg,#7FA890 0%,#9CBCA8 100%);
    --glass:rgba(255,255,255,.065);
    --glass-strong:rgba(255,255,255,.11);
    --glass-edge:rgba(255,255,255,.15);
    --glass-line:rgba(201,164,210,.22);
    --shadow-data:0 1px 3px rgba(0,0,0,.38), 0 12px 28px -12px rgba(0,0,0,.52), 0 28px 54px -30px rgba(0,0,0,.60);
    --shadow-card:0 1px 2px rgba(0,0,0,.34), 0 14px 34px -20px rgba(0,0,0,.50);
    --mote-a:rgba(229,176,120,.40);
    --mote-b:rgba(218,143,152,.34);
    --mote-c:rgba(176,137,188,.36);
  }

  *{box-sizing:border-box;}

  body{
    margin:0;
    background:var(--ground);
    color:var(--ink);
    font-family:var(--font);
    font-size:16.5px;
    line-height:1.7;
    -webkit-font-smoothing:antialiased;
  }

  #vigil{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none;}

  .page{position:relative;z-index:2;max-width:1120px;margin:0 auto;padding-inline:20px;}

  h1,h2,h3,h4{margin:0;font-weight:600;text-wrap:balance;letter-spacing:-.018em;}
  p{margin:0 0 1em;}
  p:last-child{margin-bottom:0;}

  .grad-text{
    background:var(--g-dawn);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
  }

  .glass{
    background:var(--glass);
    backdrop-filter:blur(18px) saturate(135%);
    -webkit-backdrop-filter:blur(18px) saturate(135%);
    border:1px solid var(--glass-edge);
    border-radius:18px;
    box-shadow:var(--shadow-card);
    position:relative;
    overflow:hidden;
  }
  .glass::before{
    content:"";
    position:absolute;
    inset:0 0 auto 0;
    height:1px;
    background:linear-gradient(90deg,transparent,rgba(255,255,255,.75),transparent);
    opacity:.6;
  }

  .eyebrow{
    display:inline-flex;
    align-items:center;
    gap:8px;
    font-size:11.5px;
    font-weight:600;
    letter-spacing:.15em;
    text-transform:uppercase;
    color:var(--plum);
    margin-bottom:14px;
  }
  .eyebrow .dot{
    width:7px;height:7px;border-radius:50%;
    background:var(--g-warm);
    box-shadow:0 0 10px 1px rgba(206,143,85,.55);
  }

  /* ================= HERO ================= */
  .hero{padding-block:62px 56px;text-align:center;}
  .badge{
    display:inline-flex;
    align-items:center;
    gap:9px;
    padding:8px 17px;
    border-radius:999px;
    background:var(--glass-strong);
    backdrop-filter:blur(14px) saturate(130%);
    -webkit-backdrop-filter:blur(14px) saturate(130%);
    border:1px solid var(--glass-edge);
    font-size:12.5px;
    font-weight:500;
    letter-spacing:.03em;
    color:var(--ink-soft);
    box-shadow:var(--shadow-card);
    margin-bottom:26px;
  }
  .hero h1{
    font-size:clamp(37px,8vw,70px);
    line-height:1.06;
    font-weight:600;
    letter-spacing:-.03em;
    max-width:15ch;
    margin:0 auto 20px;
  }
  .hero .sub{
    max-width:54ch;
    margin:0 auto 28px;
    font-size:18px;
    color:var(--ink-soft);
  }
  .idcard{
    display:inline-flex;
    flex-wrap:wrap;
    justify-content:center;
    align-items:center;
    gap:12px 22px;
    padding:15px 26px;
    border-radius:16px;
  }
  .idcard .nm{font-size:18.5px;font-weight:600;color:var(--ink);}
  .idcard .sep{width:1px;height:19px;background:var(--glass-line);}
  .idcard .mt{font-size:13.5px;color:var(--muted);font-weight:500;}

  /* ================= SECTIONS ================= */
  section{padding-block:46px;}
  .sec-head{max-width:64ch;margin-bottom:30px;}
  .sec-head h2{
    font-size:clamp(25px,4.8vw,38px);
    line-height:1.18;
    font-weight:600;
    letter-spacing:-.026em;
    margin-bottom:14px;
  }
  .sec-head p{font-size:17.5px;color:var(--ink-soft);margin:0;}

  .prose{max-width:64ch;color:var(--ink-soft);font-size:17px;}
  .prose strong{color:var(--ink);font-weight:600;}

  /* ================= NOT X / IT'S Y ================= */
  .pivot{padding:38px 34px;border-radius:24px;text-align:center;}
  .pivot .line{
    font-size:clamp(22px,4.4vw,36px);
    line-height:1.28;
    font-weight:600;
    letter-spacing:-.028em;
    max-width:22ch;
    margin:0 auto;
  }
  .pivot .line .no{
    color:var(--faint);
    text-decoration:line-through;
    text-decoration-thickness:2px;
    text-decoration-color:var(--rose);
  }
  .pivot .note{margin:18px auto 0;max-width:50ch;font-size:15.5px;color:var(--muted);}

  /* ================= BENTO ================= */
  .bento{display:grid;grid-template-columns:repeat(4,1fr);gap:15px;}
  .cell{
    padding:24px;
    border-radius:18px;
    display:flex;
    flex-direction:column;
    justify-content:flex-end;
    min-height:152px;
  }
  .cell.wide{grid-column:span 2;}
  .cell.dawn{background:var(--g-dawn);border:none;box-shadow:var(--shadow-data);color:#fff;}
  .cell.dusk{background:var(--g-dusk);border:none;box-shadow:var(--shadow-data);color:#fff;}
  .cell.dawn::before,.cell.dusk::before{display:none;}
  .cell .ico{
    width:34px;height:34px;
    border-radius:11px;
    display:grid;place-items:center;
    background:var(--glass-strong);
    border:1px solid var(--glass-edge);
    margin-bottom:auto;
    color:var(--plum);
    flex:none;
  }
  .cell.dawn .ico,.cell.dusk .ico{
    background:rgba(255,255,255,.20);
    border-color:rgba(255,255,255,.34);
    color:#fff;
  }
  .cell .big{
    font-size:clamp(33px,5.6vw,50px);
    line-height:1;
    font-weight:600;
    letter-spacing:-.04em;
    font-variant-numeric:tabular-nums;
    margin-top:18px;
    text-shadow:0 2px 12px rgba(58,38,52,.16);
  }
  .cell .big small{font-size:.45em;font-weight:500;opacity:.74;}
  .cell:not(.dawn):not(.dusk) .big{
    background:var(--g-dawn);
    -webkit-background-clip:text;background-clip:text;color:transparent;
    text-shadow:none;
  }
  .cell .cap{font-size:13.5px;line-height:1.5;color:var(--muted);margin-top:10px;font-weight:500;}
  .cell.dawn .cap,.cell.dusk .cap{color:rgba(255,255,255,.93);}

  /* ================= OLD / NEW ================= */
  .models{display:grid;grid-template-columns:1fr auto 1fr;gap:18px;align-items:stretch;}
  .model{padding:28px;border-radius:20px;}
  .model.new{
    border:1px solid transparent;
    background:
      linear-gradient(var(--ground),var(--ground)) padding-box,
      var(--g-dawn) border-box;
    box-shadow:var(--shadow-data);
  }
  .model h3{
    font-size:12.5px;
    font-weight:700;
    letter-spacing:.14em;
    text-transform:uppercase;
    margin-bottom:6px;
  }
  .model.old h3{color:var(--faint);}
  .model.new h3{background:var(--g-dawn);-webkit-background-clip:text;background-clip:text;color:transparent;}
  .model .tl{font-size:20px;font-weight:600;letter-spacing:-.02em;margin-bottom:18px;color:var(--ink);}
  .model ul{list-style:none;margin:0;padding:0;display:grid;gap:13px;}
  .model li{
    display:grid;grid-template-columns:auto 1fr;gap:11px;align-items:start;
    font-size:15.5px;line-height:1.55;
  }
  .model.old li{color:var(--muted);}
  .model.new li{color:var(--ink-soft);}
  .model li svg{margin-top:3px;flex:none;}
  .model.old li svg{color:var(--faint);}
  .model.new li svg{color:var(--sage);}
  .arrowbox{
    align-self:center;
    display:grid;place-items:center;
    width:48px;height:48px;
    border-radius:50%;
    background:var(--g-dawn);
    color:#fff;
    box-shadow:var(--shadow-data);
    flex:none;
  }

  /* ================= FEATURE CARDS ================= */
  .features{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;}
  .feature{padding:28px 24px;border-radius:20px;}
  .feature .fico{
    width:46px;height:46px;
    border-radius:14px;
    display:grid;place-items:center;
    background:var(--g-dawn);
    color:#fff;
    box-shadow:var(--shadow-data);
    margin-bottom:18px;
  }
  .feature:nth-child(2) .fico{background:var(--g-dusk);}
  .feature:nth-child(3) .fico{background:var(--g-calm);}
  .feature h3{font-size:18.5px;font-weight:600;margin-bottom:10px;letter-spacing:-.018em;}
  .feature p{font-size:15.5px;line-height:1.62;color:var(--muted);margin:0;}

  /* ================= CHECK LIST ================= */
  .checks{
    list-style:none;margin:0 0 4px;padding:0;
    display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;
  }
  .checks li{
    display:grid;grid-template-columns:auto 1fr;gap:12px;align-items:start;
    padding:16px 18px;border-radius:15px;
    font-size:15.5px;line-height:1.52;color:var(--ink-soft);
  }
  .checks li b{display:block;color:var(--ink);font-weight:600;margin-bottom:2px;}
  .checks li .ck{
    width:24px;height:24px;border-radius:50%;
    background:var(--g-calm);
    color:#fff;
    display:grid;place-items:center;
    flex:none;margin-top:2px;
    box-shadow:0 4px 11px -4px rgba(110,143,125,.75);
  }

  /* ================= SCOREBOARD ================= */
  .board{padding:26px;border-radius:20px;margin-top:20px;}
  .brow{
    display:grid;grid-template-columns:minmax(0,1fr) auto;gap:16px;align-items:center;
    padding-block:13px;border-bottom:1px solid var(--glass-line);
  }
  .brow:last-of-type{border-bottom:none;}
  .brow .lbl{font-size:15.5px;color:var(--ink-soft);font-weight:500;}
  .brow .vals{display:flex;align-items:center;gap:11px;font-variant-numeric:tabular-nums;white-space:nowrap;}
  .brow .from{font-size:14.5px;color:var(--faint);font-weight:500;}
  .brow .to{
    font-size:14.5px;font-weight:600;
    padding:5px 13px;border-radius:999px;
    background:var(--g-dawn);color:#fff;
    box-shadow:0 5px 14px -5px rgba(122,74,130,.7);
  }
  .fineprint{margin-top:16px;font-size:13px;line-height:1.6;color:var(--faint);max-width:56ch;}

  /* ================= CLOSE ================= */
  .close{padding:38px 34px;border-radius:24px;max-width:66ch;margin-inline:auto;text-align:center;}
  .close p{font-size:17px;color:var(--ink-soft);}
  .close strong{color:var(--ink);font-weight:600;}
  .close{margin-bottom:46px;}

  @media (max-width:900px){
    .bento{grid-template-columns:repeat(2,1fr);}
    .features{grid-template-columns:1fr;}
    .models{grid-template-columns:1fr;}
    .arrowbox{transform:rotate(90deg);justify-self:center;}
  }
  @media (max-width:620px){
    body{font-size:16px;}
    .bento{grid-template-columns:1fr;}
    .cell.wide{grid-column:span 1;}
    .checks{grid-template-columns:1fr;}
    .pivot,.close{padding:28px 20px;}
    .model,.board{padding:22px 18px;}
    .brow{grid-template-columns:1fr;gap:8px;}
    section{padding-block:38px;}
  }

  /* ================= REVEAL TRANSITIONS ================= */
  /* Each section has its own motion. These rules apply only once JS
     marks the root, so the page is fully visible if scripting never runs. */
  [data-rv="on"] .rv{
    opacity:0;
    transition-delay:var(--d,0ms);
    transition-timing-function:cubic-bezier(.22,.72,.3,1);
    transition-property:opacity,transform,filter,clip-path;
    transition-duration:1.15s;
  }
  [data-rv="on"] .rv.in{
    opacity:1;
    transform:none;
    filter:none;
    clip-path:inset(0 0 0 0);
  }
  /* Once a part has played, its finished state is locked in: no
     transition remains, so it can never animate a second time. */
  [data-rv="on"] .rv.done{
    opacity:1 !important;
    transform:none !important;
    filter:none !important;
    clip-path:none !important;
    transition:none !important;
    will-change:auto;
  }
  [data-rv="on"] .checks li.done .ck{
    opacity:1 !important;
    transform:none !important;
    transition:none !important;
  }
  [data-rv="on"] .pivot.done .no::after{
    transform:scaleX(1) !important;
    transition:none !important;
  }

  /* HERO: light coming into focus */
  [data-rv="on"] .rv-focusin{transform:scale(.965);filter:blur(12px);transition-duration:1.6s;}
  [data-rv="on"] .rv-badge{transform:translateY(-10px) scale(.82);transition-duration:1.05s;}
  [data-rv="on"] .rv-card{transform:translateY(18px) scale(.97);transition-duration:1.35s;}

  /* MISSION: a door swinging open on its hinge */
  [data-rv="on"] .rv-door{
    transform:perspective(1100px) rotateY(-24deg) translateX(-16px);
    transform-origin:left center;
    transition-duration:1.55s;
  }

  /* PIVOT: the correction settles, then the strike is drawn */
  [data-rv="on"] .rv-settle{transform:scale(.93) rotate(-.6deg);transition-duration:1.3s;}
  [data-rv="on"] .pivot .no{text-decoration:none;position:relative;}
  [data-rv="on"] .pivot .no::after{
    content:"";
    position:absolute;
    left:-.04em;right:-.04em;
    top:52%;
    height:2px;
    background:var(--rose);
    transform:scaleX(0);
    transform-origin:left center;
    transition:transform .85s cubic-bezier(.5,0,.2,1) 1.05s;
  }
  [data-rv="on"] .pivot.in .no::after{transform:scaleX(1);}

  /* BASELINE: figures resolving out of blur, in reading order */
  [data-rv="on"] .rv-resolve{transform:scale(.93);filter:blur(8px);transition-duration:1.25s;}
  [data-rv="on"] .rv-drop{transform:translateY(-18px);transition-duration:1.05s;}

  /* THE SHIFT: the two models close in from opposite sides */
  [data-rv="on"] .rv-left{transform:translateX(-52px);transition-duration:1.45s;}
  [data-rv="on"] .rv-right{transform:translateX(52px);transition-duration:1.45s;}
  [data-rv="on"] .rv-pop{transform:scale(.55);transition-duration:.85s;transition-timing-function:cubic-bezier(.34,1.42,.64,1);}

  /* HABITS: cards dealt face up */
  [data-rv="on"] .rv-deal{
    transform:perspective(900px) rotateX(20deg) translateY(28px);
    transform-origin:bottom center;
    transition-duration:1.25s;
  }
  [data-rv="on"] .rv-slidein{transform:translateX(-32px);transition-duration:1.2s;}

  /* HANDOVER: each row slides across, then its check stamps on */
  [data-rv="on"] .rv-row{transform:translateX(-28px);transition-duration:1.05s;}
  [data-rv="on"] .checks li .ck{
    transform:scale(.25);
    opacity:0;
    transition:transform .7s cubic-bezier(.34,1.5,.64,1), opacity .5s ease;
    transition-delay:calc(var(--d,0ms) + 560ms);
  }
  [data-rv="on"] .checks li.in .ck{transform:none;opacity:1;}

  /* SCOREBOARD: each row wipes open left to right */
  [data-rv="on"] .rv-wipe{clip-path:inset(0 100% 0 0);transition-duration:1.15s;}
  [data-rv="on"] .rv-quiet{transition-duration:1.2s;}

  /* LESSONS: realisations coming clear */
  [data-rv="on"] .rv-clear{filter:blur(10px);transform:translateY(14px);transition-duration:1.5s;}

  /* CLOSE: the slowest, a breath out */
  [data-rv="on"] .rv-breathe{transform:translateY(28px) scale(.975);transition-duration:1.95s;}

  @media (prefers-reduced-motion:reduce){
    *{animation:none !important;transition:none !important;}
    [data-rv="on"] .rv{opacity:1 !important;transform:none !important;filter:none !important;clip-path:none !important;}
    [data-rv="on"] .checks li .ck{opacity:1 !important;transform:none !important;}
    [data-rv="on"] .pivot .no::after{transform:scaleX(1) !important;}
  }
</style>

<canvas id="vigil" aria-hidden="true"></canvas>

<div class="page">

  <!-- ================= HERO ================= -->
  <header class="hero">
    <span class="badge glass">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 4h3a2 2 0 0 1 2 2v14"/><path d="M2 20h3"/><path d="M13 20h9"/><path d="M10 12v.01"/><path d="M13 4.562v16.157a1 1 0 0 1-1.242.97L5 20V5.562a2 2 0 0 1 1.515-1.94l4-1A2 2 0 0 1 13 4.561Z"/></svg>
      Internship Portfolio &nbsp;&middot;&nbsp; Hope&rsquo;s Door NY
    </span>
    <h1>Holding the <span class="grad-text">Door</span> Open</h1>
    <p class="sub">Four months rebuilding how a domestic violence nonprofit gets found, followed, and supported. 🕯️</p>
    <div class="idcard glass">
      <span class="nm">Jason Lin</span>
      <span class="sep"></span>
      <span class="mt">Digital Marketing Intern</span>
      <span class="sep"></span>
      <span class="mt">June to September 2026</span>
    </div>
  </header>

  <!-- ================= MISSION ================= -->
  <section>
    <div class="sec-head">
      <span class="eyebrow"><span class="dot"></span>🏡 The Mission</span>
      <h2>Make sure people can <span class="grad-text">find the door</span></h2>
      <p>Hope&rsquo;s Door gives survivors of domestic violence a way out: a 24/7 hotline, emergency shelter, counseling, and legal advocacy. All of it free.</p>
    </div>
    <p class="prose">I was asked to audit the organization&rsquo;s LinkedIn presence and rebuild the strategy, so the door reaches <strong>both</strong> audiences at once. The survivors who need to know it exists, and the businesses who can help hold it open.</p>
  </section>

  <!-- ================= PIVOT ================= -->
